{
  "doctype":"DocType",
  "name":"Label Template",
  "module":"Label Printing",
  "custom":1,
  "autoname":"field:template_name",
  "title_field":"template_name",
  "field_order":["details_tab","template_name","print_button_label","source_doctype","source_child_doctype","source_child_table","column_top_2","printer","version","status","section_label","label_width_mm","label_height_mm","number_of_ups","label_pitch_mm","horizontal_gap_mm","vertical_gap_mm","column_label_2","media_type","print_method","orientation","margin_left_mm","margin_right_mm","margin_top_mm","margin_bottom_mm","column_media_2","notes","design_tab","designer_embed","section_objects","objects"],
  "fields":[
    {"fieldname":"details_tab","label":"Label Template","fieldtype":"Tab Break"},
    {"fieldname":"template_name","label":"Template Name","fieldtype":"Data","reqd":1,"unique":1,"in_list_view":1},
    {"fieldname":"print_button_label","label":"Print Button Label","fieldtype":"Data","in_list_view":1,"mandatory_depends_on":"eval:doc.status=='Active'","description":"Text shown on the Print Label button for this DocType, e.g. \"Print Shipping Label\" or \"Print Serial Number Label\". Required before the template can be set Active."},
    {"fieldname":"source_doctype","label":"Parent ERPNext DocType","fieldtype":"Link","options":"DocType","reqd":1,"in_list_view":1},
    {"fieldname":"source_child_doctype","label":"Label Data / Child DocType","fieldtype":"Link","options":"DocType","in_list_view":1,"description":"Leave blank for a document-level label (e.g. one shipping label per document). Set this when the label is generated per row / per serial number in a child table."},
    {"fieldname":"source_child_table","label":"Child Table Fieldname","fieldtype":"Data","read_only":1,"hidden":1},
    {"fieldname":"column_top_2","fieldtype":"Column Break"},
    {"fieldname":"printer","label":"Compatible Printer","fieldtype":"Link","options":"Manage Printer","reqd":1,"in_list_view":1},
    {"fieldname":"version","label":"Version","fieldtype":"Int","default":"1","read_only":1,"in_list_view":1},
    {"fieldname":"status","label":"Status","fieldtype":"Select","options":"Draft\nActive\nArchived","default":"Draft","reqd":1,"in_list_view":1},
    {"fieldname":"section_label","label":"Physical Label / Media","fieldtype":"Section Break"},
    {"fieldname":"label_width_mm","label":"Label Width (mm)","fieldtype":"Float","reqd":1},
    {"fieldname":"label_height_mm","label":"Label Height (mm)","fieldtype":"Float","reqd":1},
    {"fieldname":"number_of_ups","label":"Number of Ups","fieldtype":"Int","reqd":1,"default":"1"},
    {"fieldname":"label_pitch_mm","label":"Label Pitch (mm)","fieldtype":"Float"},
    {"fieldname":"horizontal_gap_mm","label":"Horizontal Gap (mm)","fieldtype":"Float","default":"0"},
    {"fieldname":"vertical_gap_mm","label":"Vertical Gap (mm)","fieldtype":"Float","default":"0"},
    {"fieldname":"column_label_2","fieldtype":"Column Break"},
    {"fieldname":"media_type","label":"Media Type","fieldtype":"Select","options":"Gap / Notch\nBlack Mark\nContinuous","default":"Gap / Notch","reqd":1},
    {"fieldname":"print_method","label":"Print Method","fieldtype":"Select","options":"Direct Thermal\nThermal Transfer","default":"Direct Thermal","reqd":1},
    {"fieldname":"orientation","label":"Orientation","fieldtype":"Select","options":"Normal\nRotate 90\nRotate 180\nRotate 270","default":"Normal","reqd":1},
    {"fieldname":"margin_left_mm","label":"Left Margin (mm)","fieldtype":"Float","default":"0"},
    {"fieldname":"margin_right_mm","label":"Right Margin (mm)","fieldtype":"Float","default":"0"},
    {"fieldname":"margin_top_mm","label":"Top Margin (mm)","fieldtype":"Float","default":"0"},
    {"fieldname":"margin_bottom_mm","label":"Bottom Margin (mm)","fieldtype":"Float","default":"0"},
    {"fieldname":"column_media_2","fieldtype":"Column Break"},
    {"fieldname":"notes","label":"Notes","fieldtype":"Small Text"},
    {"fieldname":"design_tab","label":"Label Designer","fieldtype":"Tab Break"},
    {"fieldname":"designer_embed","label":"Designer","fieldtype":"HTML","options":"<div class=\"lp-designer-message\">Save the Label Template first to open the full designer.</div>"},
    {"fieldname":"section_objects","label":"Design Objects","fieldtype":"Section Break","collapsible":1,"hidden":1},
    {"fieldname":"objects","label":"Objects","fieldtype":"Table","options":"Label Template Object","reqd":0,"hidden":1}
  ],
  "permissions":[
    {"role":"Label Printing User","read":1},
    {"role":"Label Printing Manager","read":1,"write":1,"create":1,"delete":1},
    {"role":"Label Printing Administrator","read":1,"write":1,"create":1,"delete":1},
    {"role":"System Manager","read":1,"write":1,"create":1,"delete":1}
  ]
}
