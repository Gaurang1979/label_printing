{
  "doctype": "DocType",
  "name": "Manage Printer",
  "module": "Label Printing",
  "custom": 1,
  "autoname": "field:printer_name",
  "title_field": "printer_name",
  "field_order": ["printer_name","manufacturer","printer_model","enabled","column_identity","section_location","branch","warehouse","is_default_for_location","column_location_2","section_connection","connection_type","browser_print_name","ip_address","port","column_connection_2","section_capability","dpi","maximum_print_width_mm","print_method","print_speed","darkness","column_capability_2","section_calibration","tear_offset","horizontal_offset","vertical_offset","label_home_x","label_home_y","codepage","column_calibration_2","section_diagnostics","last_status","last_status_on"],
  "fields": [
    {"fieldname":"printer_name","label":"Printer Name","fieldtype":"Data","reqd":1,"unique":1,"in_list_view":1},
    {"fieldname":"manufacturer","label":"Manufacturer","fieldtype":"Data","default":"Zebra","in_list_view":1},
    {"fieldname":"printer_model","label":"Printer Model","fieldtype":"Data","default":"Zebra ZD230","reqd":1,"in_list_view":1},
    {"fieldname":"enabled","label":"Enabled","fieldtype":"Check","default":"1","in_list_view":1},
    {"fieldname":"column_identity","fieldtype":"Column Break"},
    {"fieldname":"section_location","label":"Location","fieldtype":"Section Break"},
    {"fieldname":"branch","label":"Branch / Location","fieldtype":"Link","options":"Branch","reqd":1,"in_list_view":1},
    {"fieldname":"warehouse","label":"Warehouse","fieldtype":"Link","options":"Warehouse"},
    {"fieldname":"is_default_for_location","label":"Default Printer for Location","fieldtype":"Check","default":"1"},
    {"fieldname":"column_location_2","fieldtype":"Column Break"},
    {"fieldname":"section_connection","label":"Connection","fieldtype":"Section Break"},
    {"fieldname":"connection_type","label":"Connection Type","fieldtype":"Select","options":"Browser Print - USB\nBrowser Print - Network","default":"Browser Print - USB","reqd":1},
    {"fieldname":"browser_print_name","label":"Browser Print Printer Name","fieldtype":"Data"},
    {"fieldname":"ip_address","label":"IP Address","fieldtype":"Data"},
    {"fieldname":"port","label":"Port","fieldtype":"Int","default":"9100"},
    {"fieldname":"column_connection_2","fieldtype":"Column Break"},
    {"fieldname":"section_capability","label":"Printer Capability","fieldtype":"Section Break"},
    {"fieldname":"dpi","label":"Resolution (DPI)","fieldtype":"Select","options":"203\n300\n600","default":"203","reqd":1},
    {"fieldname":"maximum_print_width_mm","label":"Maximum Print Width (mm)","fieldtype":"Float","reqd":1,"default":"104","description":"Maximum printable width. Actual label dimensions belong to the Label Template."},
    {"fieldname":"print_method","label":"Supported Print Method","fieldtype":"Select","options":"Direct Thermal\nThermal Transfer","default":"Direct Thermal"},
    {"fieldname":"print_speed","label":"Print Speed (IPS)","fieldtype":"Select","options":"2\n3\n4\n5\n6","default":"4"},
    {"fieldname":"darkness","label":"Darkness","fieldtype":"Int","default":"10"},
    {"fieldname":"column_capability_2","fieldtype":"Column Break"},
    {"fieldname":"section_calibration","label":"Printer Calibration / ZPL","fieldtype":"Section Break"},
    {"fieldname":"tear_offset","label":"Tear-Off Offset","fieldtype":"Int","default":"0"},
    {"fieldname":"horizontal_offset","label":"Horizontal Offset (dots)","fieldtype":"Int","default":"0"},
    {"fieldname":"vertical_offset","label":"Vertical Offset (dots)","fieldtype":"Int","default":"0"},
    {"fieldname":"label_home_x","label":"Label Home X (dots)","fieldtype":"Int","default":"0"},
    {"fieldname":"label_home_y","label":"Label Home Y (dots)","fieldtype":"Int","default":"0"},
    {"fieldname":"codepage","label":"Code Page","fieldtype":"Data","default":"27"},
    {"fieldname":"column_calibration_2","fieldtype":"Column Break"},
    {"fieldname":"section_diagnostics","label":"Diagnostics","fieldtype":"Section Break"},
    {"fieldname":"last_status","label":"Last Browser Print Status","fieldtype":"Small Text","read_only":1},
    {"fieldname":"last_status_on","label":"Last Status On","fieldtype":"Datetime","read_only":1}
  ],
  "permissions": [
    {"role":"Label Printing User","read":1},
    {"role":"Label Printing Manager","read":1,"write":1,"create":1,"delete":1},
    {"role":"Label Printing Administrator","read":1,"write":1,"create":1,"delete":1},
    {"role":"System Manager","read":1,"write":1,"create":1,"delete":1}
  ]
}
